{
  "name": "baglib",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.js",
    "predev": "node scripts/ensure-port-free.js && npm run copy:pdfjs",
    "prebuild": "npm run copy:pdfjs",
    "predev:next": "node --import tsx scripts/prepare-athan-audio.ts",
    "dev:next": "next dev src/renderer -p 3000 -H 127.0.0.1",
    "dev:electron": "tsup --watch --onSuccess \"electron .\"",
    "dev": "concurrently -k -s first \"npm run dev:next\" \"wait-on http://127.0.0.1:3000 && npm run dev:electron\"",
    "build:main": "tsup",
    "prebuild:renderer": "node --import tsx scripts/prepare-athan-audio.ts",
    "build:renderer": "next build src/renderer",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "start": "next start",
    "test": "node scripts/test-runner.js",
    "test:tts:live": "node scripts/tts-live/run.mjs",
    "seed:poetry": "node scripts/poetry/seed.cjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.5.0",
    "d3-force": "3.0.1",
    "docx": "9.15.2",
    "electron-serve": "^3.0.1",
    "fflate": "^0.8.3",
    "foliate-js": "^1.0.1",
    "highlight.js": "^11.12.0",
    "js-mdict": "^7.0.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.28.0",
    "next": "16.4.5",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ts-fsrs": "5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.4",
    "electron": "^32.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "css-select": "^5.1.0"
  }
}
